[Unit]
Description=Check Codex usage resets and send a notification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Use the same persistent paths for the timer and manual runs; never sandbox XDG defaults.
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_STATE_HOME=%h/.local/state
Environment=MODEL_PRICING_FILE=%h/.config/codex-reset-monitor/model-pricing.json
EnvironmentFile=-%h/.config/codex-reset-monitor/config.env
ExecStart=/usr/bin/env python3 %h/.local/lib/codex-reset-monitor/monitor.py --once --weekly-probe --env-file %h/.config/codex-reset-monitor/config.env

[Install]
WantedBy=default.target
