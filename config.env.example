# Codex CLI command. Keep this unchanged if `codex` is in PATH and already signed in.
CODEX_COMMAND="codex app-server"
CODEX_TIMEOUT_SECONDS=25
CODEX_LIMIT_ID=codex

# email, whatsapp, ntfy, stdout, or a comma-separated combination.
NOTIFY_CHANNELS=email

# Email — Gmail example. Use a 16-character Google App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
EMAIL_FROM=your-address@gmail.com
EMAIL_TO=your-address@gmail.com

# Optional WhatsApp Cloud API.
# The complete endpoint normally looks like:
# https://graph.facebook.com/<GRAPH_API_VERSION>/<PHONE_NUMBER_ID>/messages
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TO=55DDDNUMBER
# Approved template body: {{1}} followed by {{2}}. Leave blank only for free-form messages
# within an open customer-service conversation window.
WHATSAPP_TEMPLATE_NAME=codex_reset_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Optional ntfy (https://ntfy.sh) push notifications for Android/iOS.
# Install the ntfy app, subscribe to a topic, and set NTFY_TOPIC to the same value.
# A long random topic acts like a shared password on the free ntfy.sh server.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_PRIORITY=default
NTFY_TAGS=

# A reset is reported when the reset timestamp advances and usage falls by at least this amount.
RESET_MIN_PERCENT_DROP=1

# Weekly-only probe runs every minute. A full accounting checkpoint is still
# required at least every 10 minutes: requests may occur inside one displayed
# percentage or while it is capped at 100%, and logs rotate.
CHECK_INTERVAL_SECONDS=60
WEEKLY_MAX_CHECKPOINT_SECONDS=600

# Headroom and pricing accounting.
# Leave MODEL_PRICING_FILE empty to use ~/.config/codex-reset-monitor/model-pricing.json.
MODEL_PRICING_FILE=
HEADROOM_LOG_DIR=~/.headroom/logs
# Leave empty to use the proxy host's local timezone.
HEADROOM_LOG_TIMEZONE=
HEADROOM_CLIENT=codex
# Models that share the Headroom proxy but never consume Codex quota (other
# providers reached through the same proxy).  They are dropped before
# aggregation: counting them would price them as "unpriced_model", keep every
# period incomplete, and inflate the local token sum that outside-VM evidence
# compares against the Codex account counter.  Unset uses the built-in
# third-party defaults; set to an empty value to disable exclusion entirely.
# This is an exclusion list, never an allowlist, so a newly released Codex
# model still reports unpriced_model instead of silently dropping spend.
HEADROOM_EXCLUDED_MODELS=deepseek-v4.1-flash,deepseek-v4-flash,kimi-k2.6,muse-spark-1.3-contributor,gemini-3.8-flash-high
PRICING_PROCESSING_TIER=standard
PRICING_MODE=codex
# Deprecated compatibility setting.  Cache writes are not a separately billed
# category in the Codex-equivalent calculator; uncached input is always priced
# at the model's ordinary input rate.
INFERRED_CACHE_WRITE_MODE=ignored
# Cost-spike reporting thresholds for the raw checkpoint stream.
SPIKE_COST_SHARE_THRESHOLD=0.25
SPIKE_MIN_COST_USD=0.10
# A quota rise without local Headroom rows might be unproxied usage, delayed
# reporting, or incomplete proxy coverage. It does not prove outside-VM spend.  When the window already has at least
# this many completed points of priced history, the missing points are
# imputed from the window's own mean cost and in/cached/out mix, attributed
# to the historical synthetic model "external-imputed", and flagged approximate
# (status imputed_external_usage, reduced confidence) in legacy --once mode.
# The installed --weekly-probe mode excludes a rise with zero local tokens
# and reports counted/excluded points; it never invents calls. If external
# usage or counter freshness is unquantified, local/external percentage points
# cannot be separated, so all normalized $/100 projections are withheld.
# These historical synthetic tokens/calls/dollars are NOT observed usage.
# Even one local call blocked historical imputation; inspect multi-point
# intervals rather than treating their recorded price as complete.  Without enough history the
# window restarts as unattributed_usage in legacy --once mode. Set
# EXTERNAL_IMPUTATION=0 to disable legacy imputation entirely.
EXTERNAL_IMPUTATION=1
EXTERNAL_IMPUTATION_MIN_POINTS=2
# Parallel outside-VM evidence: each check also reads the account-wide
# lifetime token counter and account daily buckets from "account/usage/read"
# and stores them next to the local Headroom token sum as "external_evidence"
# in state and usage_v2 log lines. Daily bucket totals are account-wide, not
# attributable to a specific quota cycle. It does not change local cost/crossing measurements, but an
# external-use or untrustworthy-counter result withholds both account-wide and
# local-only normalized weekly $/100 estimates. The CLI exposes no account-wide
# call counts, so call-count comparison is unavailable.
# Set EXTERNAL_EVIDENCE=0 to skip the extra usage read.
EXTERNAL_EVIDENCE=1
